# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase (optional - for auth verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (required for /api/admin/* routes)
MASTER_ADMIN_ID=your-supabase-user-id

# BYOK — bring your own key (required for /api/user/api-keys, /api/user/byok-* routes)
BYOK_ENCRYPTION_KEY=64-char-hex-string-for-aes-256-gcm

# KPI context bridge (required for /api/context route)
THEKPIHUB_API_URL=https://app.thekpihub.com
CONTEXT_BRIDGE_SECRET=shared-secret-with-thekpihub-backend

# Handoff / auth (required in production -- there is no working fallback;
# the app refuses to start without these once NODE_ENV=production)
# HANDOFF_SECRET must match thekpihub.com's WINGCOMMANDER_HANDOFF_SECRET
# (.htaccess SetEnv). JWT_SECRET only needs to be a long random value, but
# must stay the same across restarts/deploys or existing sessions break.
HANDOFF_SECRET=generate-a-long-random-value-shared-with-thekpihub.com
JWT_SECRET=generate-a-separate-long-random-value

# Server
PORT=4000
# Comma-separated list of additional allowed CORS origins. thekpihub.com,
# www.thekpihub.com, blog.thekpihub.com, and this app's own
# wingcommander/wingman/dittowingman.thekpihub.com domains are always
# allowed (see src/index.ts) -- only set this for extra origins (e.g. local
# dev on a non-default port).
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
