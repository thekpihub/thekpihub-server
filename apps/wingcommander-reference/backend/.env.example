# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase (optional - for auth verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (required for /api/admin/* routes)
MASTER_ADMIN_ID=your-supabase-user-id

# BYOK — bring your own key (required for /api/user/api-keys, /api/user/byok-* routes)
BYOK_ENCRYPTION_KEY=64-char-hex-string-for-aes-256-gcm

# KPI context bridge (required for /api/context route)
THEKPIHUB_API_URL=https://app.thekpihub.com
CONTEXT_BRIDGE_SECRET=shared-secret-with-thekpihub-backend

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
